; The Last Signal — Godot 4.7.2, GDScript, Compatibility renderer.
; Keep the Web export single-threaded for static hosts such as GitHub Pages.

config_version=5

[application]

config/name="The Last Signal"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A ten-room cinematic circuit puzzle and gameplay challenge portfolio."
config/icon="res://assets/icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.039, 0.063, 0.125, 1)

[display]

window/size/viewport_width=1120
window/size/viewport_height=760
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/size/resizable=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.105, 1)
